# Original OpenAI-compatible endpoint used by test_model.py.
OPENAI_API_URL=https://example.com/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-5.4-mini

# Local/intranet OpenAI-compatible endpoint used by test_local_model.py.
# Use the /v1 base path, not /v1/models.
LOCAL_OPENAI_API_URL=http://10.1.1.3:31143/v1
LOCAL_OPENAI_API_KEY=dummy
LOCAL_OPENAI_MODEL=qwen36-35b

# Model provider used by battle planner runtime: auto, local, openai, offline.
BATTLE_PLANNER_MODEL_PROVIDER=auto
