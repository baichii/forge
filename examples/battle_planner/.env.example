# Local debug configuration. Runtime/container environment variables take precedence
# because battle_planner loads this file with override=false.

# Runtime
HOST=local
SOURCE=local
WORKFLOW_NAME=zc_lite_baseline
LLM_MODE=offline

# Model profiles
MODEL=by_qwen36
MODEL_PROFILES=by_qwen36,openai_gpt54_mini,deepseek_v4_pro

MODEL_BY_QWEN36_PROVIDER=by
MODEL_BY_QWEN36_API_URL=http://10.1.1.3:31143/v1
MODEL_BY_QWEN36_API_KEY=dummy
MODEL_BY_QWEN36_MODEL_NAME=qwen36-35b

MODEL_OPENAI_GPT54_MINI_PROVIDER=openai
MODEL_OPENAI_GPT54_MINI_API_URL=https://example.com/v1
MODEL_OPENAI_GPT54_MINI_API_KEY=replace-with-your-key
MODEL_OPENAI_GPT54_MINI_MODEL_NAME=gpt-5.4-mini

MODEL_DEEPSEEK_V4_PRO_PROVIDER=deepseek
MODEL_DEEPSEEK_V4_PRO_API_URL=https://api.deepseek.com
MODEL_DEEPSEEK_V4_PRO_API_KEY=replace-with-your-key
MODEL_DEEPSEEK_V4_PRO_MODEL_NAME=deepseek-v4-pro
MODEL_DEEPSEEK_V4_PRO_REASONING_EFFORT=high
MODEL_DEEPSEEK_V4_PRO_THINKING_TYPE=enabled

BATTLE_PLANNER_LLM_MAX_TOKENS=2048
BATTLE_PLANNER_LLM_TIMEOUT_SECONDS=30
BATTLE_PLANNER_LLM_MAX_RETRY=2

# Workflow
BATTLE_PLANNER_MAX_STAGE_RETRY=2
BATTLE_PLANNER_WORKFLOW_MAX_ITERATIONS=5
BATTLE_PLANNER_FAIL_FAST=false
BATTLE_PLANNER_SAVE_ARTIFACTS=true
BATTLE_PLANNER_ARTIFACT_DIR=examples/battle_planner/artifacts

# Simulation
BATTLE_PLANNER_SIM_RUNS_PER_PLAN=3
BATTLE_PLANNER_SIM_MAX_PARALLEL=1
BATTLE_PLANNER_SIM_MAX_DECISION_STEPS=
BATTLE_PLANNER_SIM_MAX_FAILURES=1
BATTLE_PLANNER_SIM_RANDOM_SEED=

# Report
BATTLE_PLANNER_REPORT_LEVEL=full
BATTLE_PLANNER_REPORT_INCLUDE_LLM_TRACE=true
BATTLE_PLANNER_REPORT_INCLUDE_SIM_LOGS=true
BATTLE_PLANNER_REPORT_INCLUDE_FAILED_RUNS=true
BATTLE_PLANNER_REPORT_FORMAT=md

# Tests
BATTLE_PLANNER_RUN_MODEL_TESTS=false
